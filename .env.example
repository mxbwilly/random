# --- Database (Postgres). Locally: docker compose up -d, or any Postgres 14+.
# If port 5432 is already in use on your machine, change BOTH lines to another port (e.g. 5433).
DB_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/backexams"

# --- App
APP_NAME="BackExams"
APP_URL="http://localhost:3000"
# Comma-separated emails that are promoted to ADMIN on signup/login.
ADMIN_EMAILS=""

# --- Email (Resend). Leave RESEND_API_KEY empty to log emails to the console instead.
RESEND_API_KEY=""
EMAIL_FROM="BackExams <noreply@example.com>"

# --- File storage (Supabase Storage). Leave empty to store files on local disk under ./storage (dev only).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="exams"

# --- Limits
MAX_UPLOAD_MB="25"

# --- Optional: error tracking (Sentry) and privacy-friendly analytics (Plausible)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
